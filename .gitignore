bots/*/storage/*.json
storage/*.json

# V2 SQLite database (runtime artifact)
v2/data/*.db
v2/data/*.db-shm
v2/data/*.db-wal

# Logs
logs/*.log
*.log

# Test artifacts
.pytest_temp/
.pytest_cache/

# Platform artifacts (Replit / Emergent)
.replit
.emergent/
skills-lock.json
