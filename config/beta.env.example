# Project Beta local configuration. Copy to .env; never commit the resulting file.
DEPLOYMENT_MODE=PAPER
TRADING_ENABLED=false
BROKER=PAPER
EXCHANGE=NSE
PRODUCT_TYPE=CNC
PUBLIC_MARKET_DATA_PROVIDER=YAHOO
ORDER_SIZE_INR=10000
DB_PATH=data/project_beta.db
SCANNER_DB_PATH=scanner/data/beta_scanner.db
PAPER_DB_PATH=paper/data/beta_paper.db
LEARNER_DB_PATH=learner/data/beta_learner.db

# Optional Beta-only Zerodha credentials
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

# Optional Beta-only Dhan credentials
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Optional notifications/AI; leave blank for keyless local operation
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=
GEMINI_API_KEY=
