# Project Beta v1: PAPER is the only accepted execution mode.
EXECUTION_MODE=PAPER
DEPLOYMENT_MODE=PAPER
TRADING_ENABLED=false
BROKER=PAPER
MARKET_DATA_PROVIDER=YAHOO
DB_PATH=data/project_beta.db
SCANNER_DB_PATH=data/project_beta.db
PAPER_DB_PATH=data/project_beta.db
LEARNER_DB_PATH=data/project_beta.db
INITIAL_PAPER_CASH=15000
ORDER_SIZE_INR=1000
PRICE_CEILING_INR=250.0
PRICE_FLOOR_INR=0.0
DAILY_LOSS_WARNING_INR=750
DAILY_ENTRY_BLOCK_INR=900
DAILY_LOSS_LIMIT_INR=1000
MAX_OPEN_POSITIONS=15
MAX_POSITIONS_PER_SECTOR=3
MAX_CONSECUTIVE_LOSSES=3

# Single Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Dhan market-data WebSocket only. Never used for orders.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Optional TradingView API key (leave blank for keyless public mode)
TRADINGVIEW_API_KEY=
