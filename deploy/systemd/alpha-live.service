[Unit]
Description=PROJECT-ALPHA Live Execution Service (INACTIVE - EXCLUDED FROM DEPLOYMENT)
After=network.target alpha-scanner.service
RefuseManualStart=yes

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/project-alpha
Environment=MODE=LIVE
Environment=DEPLOYMENT_MODE=LIVE
Environment=TRADING_ENABLED=false
EnvironmentFile=-/opt/project-alpha/.env
EnvironmentFile=-/opt/project-alpha/deploy/env/live.env
ExecStart=/bin/sh -c 'echo "ERROR: Live Bot service is inactive and excluded from active deployment." >&2; exit 1'
Restart=no
StandardOutput=journal
StandardError=journal

# [Install] section disabled to prevent service from being enabled in systemd:
# [Install]
# WantedBy=multi-user.target
