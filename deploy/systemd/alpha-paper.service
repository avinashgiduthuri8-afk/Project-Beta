[Unit]
Description=PROJECT-ALPHA Paper Execution Service
After=network.target alpha-scanner.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/project-alpha
Environment=PYTHONPATH=/opt/project-alpha:/opt/project-alpha/shared:/opt/project-alpha/services
Environment=MODE=PAPER
Environment=DEPLOYMENT_MODE=PAPER
Environment=DB_PATH=paper/data/alpha_paper.db
Environment=SCANNER_DB_PATH=scanner/data/alpha_scanner.db
EnvironmentFile=-/opt/project-alpha/.env
EnvironmentFile=-/opt/project-alpha/deploy/env/paper.env
ExecStart=/opt/project-alpha/.venv/bin/python3 -m services.paper_bot.main
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
