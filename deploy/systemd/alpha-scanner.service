[Unit]
Description=PROJECT-ALPHA Scanner Service (Brain)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/project-alpha
Environment=PYTHONPATH=/opt/project-alpha:/opt/project-alpha/shared:/opt/project-alpha/services
Environment=MODE=SCANNER
Environment=DB_PATH=scanner/data/alpha_scanner.db
Environment=SCANNER_DB_PATH=scanner/data/alpha_scanner.db
Environment=LEARNER_DB_PATH=learner/data/alpha_learner.db
EnvironmentFile=-/opt/project-alpha/.env
EnvironmentFile=-/opt/project-alpha/deploy/env/scanner.env
ExecStart=/opt/project-alpha/.venv/bin/python3 -m services.scanner.main
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
