[Unit]
Description=Project Beta Paper Trading (stages 6-7)
After=beta-scanner.service

[Service]
User=project-beta
Group=project-beta
WorkingDirectory=/opt/project-beta
EnvironmentFile=/opt/project-beta/.env
Environment=PYTHONPATH=/opt/project-beta:/opt/project-beta/services:/opt/project-beta/shared
ExecStart=/opt/project-beta/.venv/bin/python -m services.paper_bot.main
Restart=on-failure
RestartSec=10
MemoryMax=640M
CPUQuota=30%
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
